#let family(fam, variant: "light") = {
  let table = if variant == "dark" { dark } else { light }
  if not (fam in table) { panic("rx: familia desconocida: " + fam + " -- disponibles: " + families().join(", ")) }
  table.at(fam)
}

#let get(fam, step, variant: "light") = {
  let ramp = family(fam, variant: variant)
  let key = str(int(str(step)))
  if not (key in ramp) { panic("rx: paso fuera de rango: " + str(step) + " -- usar 1..12") }
  ramp.at(key)
}
