// Tailwind v4 define white y black sueltos (hex, sin pasos): no entran en la referencia
// tw4-familia-paso; se ofrecen como constantes.
#let white = rgb("#fff")
#let black = rgb("#000")

#let families() = ("red", "orange", "amber", "yellow", "lime", "green", "emerald", "teal", "cyan", "sky", "blue", "indigo", "violet", "purple", "fuchsia", "pink", "rose", "slate", "gray", "zinc", "neutral", "stone", "mauve", "olive", "mist", "taupe")
#let steps() = ("50", "100", "200", "300", "400", "500", "600", "700", "800", "900", "950")

#let family(fam) = {
  if not (fam in data) { panic("tw4: familia desconocida: " + fam + " -- disponibles: " + families().join(", ")) }
  data.at(fam)
}

#let get(fam, step) = {
  let ramp = family(fam)
  let key = str(step)
  if not (key in ramp) { panic("tw4: paso desconocido: " + key + " -- disponibles: " + steps().join(", ")) }
  ramp.at(key)
}
